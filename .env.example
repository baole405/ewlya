# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ewlya_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/ewlya_db?schema=public"

# App
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Discord OAuth2 (for web login)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token
HOF_CHANNEL_ID=your_hof_channel_id
TEST_CHANNEL_ID=your_test_channel_id
MINES_DROPS_CHANNEL_ID=1265850153517060096

# Admin ID
ADMIN_IDS

# AI Configuration (Gemini, OpenRouter, Pollinations, OpenAI-compatible)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini # Choice of: gemini, pollinations, openrouter, openai
AI_MODEL=gemini-flash-latest # E.g., command-r, deepseek-r1 (for pollinations) or meta-llama/llama-3-8b-instruct:free (for openrouter)
AI_API_KEY=your_provider_api_key_here # Optional (ignored for pollinations)
AI_BASE_URL=https://api.openai.com/v1 # Optional (for custom openai endpoints)
MOCK_AI=false

# Local Priority Config (for local bot instances to lease-pause production bot)
IS_LOCAL_BOT=false
PRODUCTION_URL=https://your-production-app.onrender.com

