{
  "name": "ewlya-backend",
  "version": "1.0.0",
  "description": "Ewlya Backend Hub - API & Discord Bot",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:api": "nest start",
    "start:bot": "tsx src/bot/main.ts",
    "start:dev:api": "nest start --watch",
    "start:dev:bot": "tsx watch src/bot/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod:api": "node dist/main",
    "start:prod:bot": "node dist/bot/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.4.1",
    "bcrypt": "^6.0.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "prisma": "^6.4.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-discord": "^0.1.15",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.0.0",
    "jest-environment-node": "^30.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
