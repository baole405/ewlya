{
  "name": "db",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/db/src",
  "projectType": "library",
  "tags": ["main"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/db",
        "main": "libs/shared/db/src/index.ts",
        "tsConfig": "libs/shared/db/tsconfig.lib.json",
        "assets": ["libs/shared/db/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/db/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate --schema=libs/shared/db/prisma/schema.prisma"
      }
    },
    "db-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma db push --schema=libs/shared/db/prisma/schema.prisma"
      }
    },
    "prisma-studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma studio --schema=libs/shared/db/prisma/schema.prisma"
      }
    }
  }
}
