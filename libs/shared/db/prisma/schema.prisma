generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

model Member {
  id        String   @id @default(cuid())
  discordId String   @unique
  ign       String
  nickname  String
  points    Int      @default(0)
  gsCode    String?
  avatarUrl String?
  role      Role     @default(MEMBER)
  
  // Fields from Google Sheets
  gender    String?
  birthdate DateTime?
  age       Int?
  country   String?
  aka       String?  // Biệt danh khác
  status    String   @default("ACTIVE") // ACTIVE, FORMER
  
  submissions Submission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  mission    String
  reason     String?  // Lý do cập nhật điểm
  rank       Int?
  points     Int
  seasonId   String
  season     Season   @relation(fields: [seasonId], references: [id])
  verifiedBy String   // Discord ID of admin who verified
  createdAt  DateTime @default(now())
}

model Season {
  id        String       @id @default(cuid())
  name      String       @unique
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean      @default(false)
  submissions Submission[]
}
